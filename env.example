# VoicePilot Environment Configuration Template
# Copy this file to .env and fill in your actual values

# ============================================================================
# API Configuration
# ============================================================================
POST_PROCESS_URL=https://your-api-endpoint.com/process
POST_PROCESS_URL_PROD=https://your-production-api-endpoint.com/process


# API Headers
CONTENT_TYPE=application/json
CONTENT_TYPE_PROD=application/json
DEPLOYMENT_KEY=your-deployment-key-here
DEPLOYMENT_KEY_PROD=your-production-deployment-key-here
X_VA_SENDERAGENT_ID=your-sender-agent-id-here
X_VA_SENDERAGENT_ID_PROD=your-production-sender-agent-id-here

# Database Insert API Configuration
DB_INSERT_API_BASE_URL=https://artranscriptionapi.vitalaxis.com
DB_INSERT_API_AUDIO_URL=https://artranscriptionapi.vitalaxis.com/api/AudioFiles/InsertDataClaimCallAudioRecordings
DB_INSERT_API_EXTRACTS_URL=https://artranscriptionapi.vitalaxis.com/api/AudioFiles/InsertDataClaimCallRecordingExtracts

# Database Insert API Headers (add authentication if required)
DB_INSERT_API_AUTH_TOKEN=your-auth-token-here
DB_INSERT_API_AUTH_TOKEN_PROD=your-production-auth-token-here
DB_INSERT_API_KEY=your-api-key-here
DB_INSERT_API_KEY_PROD=your-production-api-key-here

# API Timeout (seconds)
API_TIMEOUT_SEC=30

# ============================================================================
# Database Configuration - Production
# ============================================================================
DB_PROD_HOST=your-prod-db-host.database.windows.net
DB_PROD_PORT=3342
DB_PROD_DATABASE=your-prod-database
DB_PROD_USER=your-prod-user
DB_PROD_PASSWORD=your-prod-password

# ============================================================================
# Database Configuration - QC/Testing
# ============================================================================
DB_QC_HOST=your-qc-db-host
DB_QC_PORT=3342
DB_QC_DATABASE=your-qc-database
DB_QC_USER=your-qc-user
DB_QC_PASSWORD=your-qc-password

# Optional toggle to use PROD instead of QC (overrides config)
# Accepts: true/false, 1/0, yes/no, on/off
DB_USE_PROD=false

# ============================================================================
# Logging Configuration
# ============================================================================
VOICLAIM_LOG_LEVEL=INFO

# ============================================================================
# SMTP Configuration (for email alerts)
# ============================================================================
SMTP_SENDER=alerts@yourdomain.com
SMTP_RECEIVER=admin@yourdomain.com
SMTP_SERVER=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USERNAME=alerts@yourdomain.com
SMTP_PASSWORD=your-smtp-password

# ============================================================================
# Security & Development
# ============================================================================
# Set to 'development' or 'production'
ENVIRONMENT=development
